{
  "name": "supply-chain-content-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Frank Cruz's local LinkedIn content engine: research, write in his voice, schedule in Typefully.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "prisma migrate deploy && tsx scripts/seed.ts",
    "predev": "prisma migrate deploy",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "prestart": "prisma migrate deploy && next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "cron": "tsx scripts/cron.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.10",
    "heic-convert": "^2.1.0",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
